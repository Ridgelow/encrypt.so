# Cloudflare Worker origin, no trailing slash.
# Phone auth, POST /devices, and PUT /devices/:id/prekey-bundle.
# Leave unset to keep onboarding offline (keys stay on device, no upload).
EXPO_PUBLIC_API_URL=http://127.0.0.1:8787

# Worker secret. Not read by the Expo client (no EXPO_PUBLIC_ prefix).
# The EAS project id used for Expo push tokens already lives in app.json → extra.eas.projectId.
# Set the access token on the Worker only:
#   cd workers && npx wrangler secret put EXPO_ACCESS_TOKEN
# Leave it unset to stub delivery: the worker logs `push stub` and does not call exp.host.
# EXPO_ACCESS_TOKEN=

# Worker guardrails (not Expo). Defaults are in workers/wrangler.toml [vars].
# No secrets in this list. MESSAGE_TTL_MS=0 keeps rows until their disappearing expireAt.
# RATE_* = 0 disables that limiter. BLOCKLIST_* are comma-separated.
# KV hooks: block:ip:<ip>  block:phone:<+E.164>  block:user:<userId>
# MESSAGE_TTL_MS=2592000000
# RATE_AUTH_START_PER_PHONE=8
# RATE_AUTH_START_PER_IP=30
# RATE_AUTH_START_WINDOW_SEC=600
# RATE_AUTH_VERIFY_PER_IP=40
# RATE_AUTH_VERIFY_WINDOW_SEC=600
# AUTH_FAIL_BACKOFF_BASE_MS=1000
# AUTH_FAIL_BACKOFF_MAX_MS=900000
# RATE_MESSAGE_PER_USER=60
# RATE_MESSAGE_PER_IP=120
# RATE_MESSAGE_WINDOW_SEC=60
# RATE_PUSH_PER_USER=10
# RATE_PUSH_PER_IP=20
# RATE_PUSH_WINDOW_SEC=60
# RATE_ATTACHMENT_PER_USER=30
# RATE_ATTACHMENT_PER_IP=60
# RATE_ATTACHMENT_WINDOW_SEC=60
# MAX_BODY_BYTES=65536
# MAX_CIPHERTEXT_CHARS=49152
# MAX_ATTACHMENT_BYTES=26214400
# MAX_WS_PER_CONVERSATION=32
# MAX_WS_PER_USER=8
# MAX_WS_PER_USER_GLOBAL=16
# BLOCKLIST_PHONES=
# BLOCKLIST_IPS=
