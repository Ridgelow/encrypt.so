{
  "cli": {
    "version": ">= 24.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "bundleIdentifier": "so.encrypt.app",
        "language": "en-US"
      },
      "android": {
        "applicationId": "so.encrypt.app",
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "ios": {
        "bundleIdentifier": "so.encrypt.app",
        "language": "en-US"
      },
      "android": {
        "applicationId": "so.encrypt.app",
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
